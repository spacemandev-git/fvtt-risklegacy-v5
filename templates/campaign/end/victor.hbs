<div class="rl-camp-step rl-camp-step--victor">
  <h2 class="rl-title">{{localize "RL.Wizard.End.victorTitle"}}</h2>
  <p class="rl-lead">{{localize "RL.Wizard.End.victorLead" name=winner.player faction=winner.factionName}}</p>
  {{> "systems/fvtt-risklegacy-v5/templates/campaign/parts/victors.hbs" lines=lines}}
